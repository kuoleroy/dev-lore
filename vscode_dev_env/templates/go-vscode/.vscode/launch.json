{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Debug Package",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Go: Debug Current File",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Go: Attach (dlv local)",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Go: Remote Attach (dlv)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "remotePath": "${workspaceFolder}",
      "host": "127.0.0.1",
      "port": 2345
    }
  ]
}