{
  "//": "cargo 类型任务由 rust-analyzer 扩展提供",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build",
      "type": "cargo",
      "command": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "cargo: run",
      "type": "cargo",
      "command": "run",
      "problemMatcher": []
    },
    {
      "label": "cargo: test",
      "type": "cargo",
      "command": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "cargo: clippy",
      "type": "cargo",
      "command": "clippy",
      "args": [
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ],
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "cargo: fmt",
      "type": "cargo",
      "command": "fmt",
      "problemMatcher": []
    }
  ]
}