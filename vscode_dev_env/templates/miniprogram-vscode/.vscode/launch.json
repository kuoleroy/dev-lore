{
  "version": "0.2.0",
  "configurations": [
    {
      "//": "小程序页面调试需使用微信开发者工具；此配置用于 node 侧单元测试（miniprogram-simulate）",
      "name": "Miniprogram: 单元测试 (Jest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test",
        "--",
        "--runInBand"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}